      "toolbar_field_highlight_text": "#FFFFFF",
      "popup": "#1B1048",
      "popup_text": "#ECE8FA",
      "popup_border": "#2E2070",
      "popup_highlight": "#33247D",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#120A33",
      "sidebar_text": "#ECE8FA",
      "sidebar_border": "#2E2070",
      "sidebar_highlight": "#4320CC",
      "sidebar_highlight_text": "#FFFFFF",
      "ntp_background": "#120A33",
      "ntp_text": "#ECE8FA"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  }
}
