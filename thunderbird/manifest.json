{
  "manifest_version": 2,
  "version": "2026.10.0",
  "name": "ThatDataPurple",
  "description": "A purple theme for Thunderbird in the That Data Person brand colours, by That Data Person Limited.",
  "author": "That Data Person Limited (www.thatdataperson.com)",
  "browser_specific_settings": {
    "gecko": {
      "id": "thatdatapurple@thatdataperson.com",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "128": "images/ThatDataPurple.icon.png"
  },
  "theme_experiment": {
    "colors": {
      "tdp_window": "--lwt-frame",
      "tdp_window_inactive": "--lwt-frame-inactive",
      "tdp_message_list": "--tree-view-bg",
      "tdp_layout_0": "--layout-background-0",
      "tdp_layout_1": "--layout-background-1",
      "tdp_layout_2": "--layout-background-2",
      "tdp_layout_3": "--layout-background-3"
    }
  },
  "theme": {
    "colors": {
      "frame": "#0D0629",
      "frame_inactive": "#120A33",
      "tab_background_text": "#FFFFFF",
      "tab_selected": "#4320CC",
      "tab_text": "#FFFFFF",
      "tab_line": "#B9A8FF",
      "tab_loading": "#B9A8FF",
      "toolbar": "#4320CC",
      "toolbar_text": "#FFFFFF",
      "icons": "#FFFFFF",
      "icons_attention": "#FFCB6B",
      "button_background_hover": "#5236D6",
      "button_background_active": "#6A4EDA",
      "toolbar_top_separator": "#0D0629",
      "toolbar_bottom_separator": "#0D0629",
      "toolbar_vertical_separator": "#6A4EDA",
      "toolbar_field": "#120A33",
      "toolbar_field_text": "#ECE8FA",
      "toolbar_field_border": "#B9A8FF",
      "toolbar_field_focus": "#0D0629",
      "toolbar_field_text_focus": "#ECE8FA",
      "toolbar_field_border_focus": "#FFFFFF",
      "toolbar_field_highlight": "#4320CC",
      "toolbar_field_highlight_text": "#FFFFFF",
      "popup": "#1B1048",
      "popup_text": "#ECE8FA",
      "popup_border": "#2E2070",
      "popup_highlight": "#33247D",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#120A33",
      "sidebar_text": "#ECE8FA",
      "sidebar_border": "#2E2070",
      "sidebar_highlight": "#4320CC",
      "sidebar_highlight_text": "#FFFFFF",
      "tdp_window": "#0D0629",
      "tdp_window_inactive": "#120A33",
      "tdp_message_list": "#120A33",
      "tdp_layout_0": "#0D0629",
      "tdp_layout_1": "#120A33",
      "tdp_layout_2": "#1B1048",
      "tdp_layout_3": "#271862"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  }
}
